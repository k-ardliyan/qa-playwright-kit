# Salin → environments/production.env (jangan commit file berisi password nyata)
# Panduan: docs/GUIDE.md + docs/CREDENTIALS.md
#
# APP_ENV memilih file ini (OS / pin / default) — bukan key di dalam file.
# Setiap role: PASSWORD + minimal satu dari EMAIL | USERNAME | PHONE.
# Resolve login id: LOGIN_ID_PREF → email → username → phone.

# ── URL Aplikasi ─────────────────────────────────────────────────
BASE_URL=https://your-app.example.com/

# ── Role: user (default account for pipeline mode "general") ─────
TEST_USER_EMAIL=test@example.com
TEST_USER_USERNAME=
TEST_USER_PHONE=
TEST_USER_PASSWORD=your_password_here
# TEST_USER_LOGIN_ID_PREF=email
# Path halaman login & redirect setelah sukses (per-role, tanpa trailing slash).
# Default bila kosong: /login dan /dashboard.
# TEST_USER_LOGIN_URL_PATH=/login
# TEST_USER_SUCCESS_URL_PATH=/dashboard

# Multi-tenant: kode company/tenant yang diketik di form login (opsional).
# Kosong = tidak ada langkah company. Override selector bila field tidak terdeteksi:
# TEST_USER_COMPANY=
# TEST_USER_COMPANY_SELECTOR=

# ── Role lain (opsional, multi-role) — skema sama ────────────────
# Nama role BEBAS (kebab-case): apa pun yang Anda tulis di requirement `Role scope`.
# Ganti <ROLE> dengan nama role, mis. FINANCE_ / SUPER_ADMIN_ / HRD_ / GURU_ / ADMIN_.
# Suffix yang dikenali: _EMAIL _USERNAME _PHONE _PASSWORD _LOGIN_ID_PREF
#   _LOGIN_URL_PATH _SUCCESS_URL_PATH _COMPANY _COMPANY_SELECTOR
# Role terdeteksi otomatis bila PASSWORD + salah satu identitas (EMAIL|USERNAME|PHONE) terisi.
#
# <ROLE>_EMAIL=user@example.com
# <ROLE>_USERNAME=
# <ROLE>_PHONE=
# <ROLE>_PASSWORD=your_password_here
# <ROLE>_LOGIN_ID_PREF=phone
# <ROLE>_LOGIN_URL_PATH=/login
# <ROLE>_SUCCESS_URL_PATH=/dashboard
# <ROLE>_COMPANY=              # kode tenant/company bila form login multi-tenant
# <ROLE>_COMPANY_SELECTOR=     # override selector field company
#
# Contoh konkret:
# FINANCE_EMAIL=finance@example.com
# FINANCE_PASSWORD=your_password_here
# FINANCE_LOGIN_ID_PREF=phone
# SUPER_ADMIN_EMAIL=superadmin@example.com
# SUPER_ADMIN_PASSWORD=your_password_here
#
# npm run env:edit
# npm run auth:setup
# OTP/CAPTCHA: npm run auth:setup:headed

# ── Browser (opsional) ───────────────────────────────────────────
HEADLESS=true
SLOW_MO=0
# Viewport desktop semua project (default Full HD 1920x1080, resolusi desktop
# paling umum). Format WIDTHxHEIGHT. Turunkan bila perlu render lebih ringan:
# QA_VIEWPORT=1920x1080
# QA_VIEWPORT=1600x900

# ── Langkah tambahan login (OTP / CAPTCHA) — assisted, local only ─
# none | otp-browser (disarankan utk OTP) | otp-stdin | captcha-browser | auto
AUTH_CHALLENGE_MODE=none
# AUTH_CHALLENGE_TIMEOUT_MS=180000
# AUTH_OTP_INPUT_SELECTOR=
# AUTH_OTP_SUBMIT_SELECTOR=
# otp-browser / captcha-browser → set HEADLESS=false (wizard/env:edit otomatis)
# CI: biarkan none. Skenario OTP/CAPTCHA di requirement tetap (@manual).

# ── Override auth global (tanpa prefix role) — opsional ──────────
# Dipakai bila SEMUA role berbagi halaman login/redirect yang sama.
# Default (kosong): /login dan /dashboard. Path per-role menang atas global ini.
# AUTH_LOGIN_URL_PATH=/login
# AUTH_SUCCESS_URL_PATH=/dashboard
# Penanda teks sukses login (opsional, untuk assert eksplisit).
# AUTH_SUCCESS_TEXT=
# Escape hatch: paksa login ulang walau sesi masih valid (mis. hak akses berubah).
# AUTH_FORCE_LOGIN=true

# ── Playwright profile ───────────────────────────────────────────
PLAYWRIGHT_CONFIG=playwright.config.ts

# ── Origin tambahan untuk health check / MCP (opsional) ──────────
# Bila API berada di origin berbeda dari UI, daftarkan agar dianggap allowed.
# APP_BASE_URL=https://app.example.com
# API_BASE_URL=https://api.example.com

# ── Advanced / tooling knobs (jarang diubah) ─────────────────────
# LOG_LEVEL=debug                 # aktifkan log DEBUG (default: info)
# UPDATE_HAR=1                    # rekam ulang HAR di network-assert helper
# QA_COVERAGE_ROOT=               # override repo root untuk validate:coverage
# QA_WORKSPACE_MANIFEST_MODE=     # mode manifest workspace: compat (default) | strict
# SELECTOR_CATALOG_MAX_FILES=100  # batas file katalog per fitur (snapshot_page)
# CODEGEN_PW_VERSION=1.58.0       # versi Playwright untuk codegen --debug=cli
# CODEGEN_BLOCK_SW=1              # blokir service worker saat codegen
# PLAYWRIGHT_TEST_ROOT=           # override root scan spec MCP (default: tests)
# PLAYWRIGHT_ADAPTER_TEST_ROOT=   # root spec reference-adapter (workspace custom)
# PLAYWRIGHT_ADAPTER_CONFIG=      # config Playwright reference-adapter
# PLAYWRIGHT_ADAPTER_RESULTS_JSON=# path results.json adapter
# PLAYWRIGHT_ADAPTER_FIXTURE_IMPORT= # import base.fixture untuk spec adapter