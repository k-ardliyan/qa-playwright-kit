{
  "name": "qa-playwright-kit-mcp-server",
  "version": "2.0.0",
  "description": "MCP server exposing QA-specific tools for the Playwright AI Agent Framework via stdio transport",
  "main": "dist/index-mcp.js",
  "bin": {
    "qa-playwright-kit-mcp": "./dist/index-mcp.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index-mcp.js",
    "start:http": "node dist/index.js",
    "dev": "tsx src/index-mcp.ts",
    "dev:http": "tsx src/index.ts"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.21.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/test": "^1.62.1",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "exceljs": "^4.4.0",
    "pdf-parse": "^2.4.5",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "hono": "^4.12.31"
  }
}
