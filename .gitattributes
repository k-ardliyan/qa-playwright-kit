# Auto-detect text files
* text=auto eol=lf

# Source code — keep LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Markdown — normalize to LF (cross-platform consistent rendering)
*.md text eol=lf

# Scripts
*.sh text eol=lf
*.ps1 text eol=lf

# Dotenv templates — keep LF so they work on any OS
*.env.example text eol=lf
.env* text eol=lf

# Config files
.gitignore text eol=lf
.gitattributes text eol=lf
.biome.json text eol=lf
.biome.jsonc text eol=lf
.claudeignore text eol=lf
tsconfig.json text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.xlsx binary
*.zip binary
*.gz binary
*.tar binary
*.tgz binary
node_modules/** binary
tools/mcp/dist/** binary

# Hybrid Architecture runtime output directories — binary blobs
artifacts/** binary
test-results/** binary
playwright-report/** binary
blob-report/** binary

# Auth state files (sensitive + JSON)
.auth/** text eol=lf

# Environments & config — keep LF
config/environments/** text eol=lf
config/playwright/** text eol=lf
environments/** text eol=lf
