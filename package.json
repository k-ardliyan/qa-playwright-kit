{
  "name": "qa-playwright-kit",
  "version": "0.2.0-alpha.1",
  "private": true,
  "description": "Reusable QA Playwright Kit E2E acceleration framework with interactive runner, page objects, custom reporting, and AI-assisted workflow support",
  "keywords": [
    "playwright",
    "e2e",
    "qa",
    "automation",
    "typescript",
    "page-object-model",
    "test-accelerator"
  ],
  "scripts": {
    "lint": "biome lint . && npm run lint:playwright",
    "lint:fix": "biome lint --write . && npm run lint:playwright:fix",
    "lint:playwright": "eslint --config eslint.playwright.config.mjs tests/**/*.spec.ts",
    "lint:playwright:fix": "eslint --config eslint.playwright.config.mjs tests/**/*.spec.ts --fix",
    "format": "biome format --write . && tsx tools/scripts/format-markdown.ts",
    "format:markdown": "tsx tools/scripts/format-markdown.ts",
    "format:check": "biome format . && tsx tools/scripts/format-markdown.ts --check",
    "typecheck": "tsc --noEmit",
    "validate": "tsx tools/validators/validate-generated-tests.ts",
    "validate:requirement": "tsx tools/validators/validate-requirement.ts",
    "validate:architecture": "tsx tools/validators/architecture.ts",
    "validate:coverage": "tsx tools/validators/coverage-map.ts",
    "validate:ephemeral": "tsx tools/validators/ephemeral-ref-guard.ts",
    "validate:test-plan": "npx playwright test src/__tests__/unit/compile-test-plan.test.ts src/__tests__/unit/validate-plan.test.ts -c config/playwright/unit.ts",
    "test": "npx playwright test --grep-invert @demo",
    "test:ci": "npm run test",
    "test:demo": "npx playwright test --project=demo --workers=1",
    "test:smoke": "npx playwright test --grep @smoke",
    "test:unit": "npx playwright test -c config/playwright/unit.ts",
    "test:contract": "npx playwright test src/__tests__/unit/golden-contract-ci.test.ts -c config/playwright/unit.ts",
    "test:traceability": "npx playwright test src/__tests__/unit/trace-requirement.test.ts -c config/playwright/unit.ts",
    "test:mcp-profiles": "npx playwright test src/__tests__/unit/tool-registry.test.ts src/__tests__/unit/mcp-profiles.test.ts -c config/playwright/unit.ts",
    "test:dashboard-browser": "npx playwright test -c config/playwright/dashboard.ts",
    "test:property": "tsx tools/scripts/run-property-tests.ts",
    "test:file-content": "tsx src/support/pw/__tests__/file-content-core.test.ts",
    "test:network-assert": "tsx src/support/pw/__tests__/network-assert-core.test.ts",
    "install:mcp-server": "node tools/scripts/install-mcp-server.cjs",
    "mcp:check": "tsx tools/scripts/mcp-compat-check.ts",
    "mcp:build": "npm run install:mcp-server && npm run sync:file-core && npx tsc src/utils/app-env.ts src/utils/env-loader.ts src/utils/logger.ts --outDir src/utils --module commonjs --target es2020 --esModuleInterop --declaration --skipLibCheck --types node && cd tools/mcp && npm run build",
    "mcp:config": "tsx tools/scripts/mcp-config.ts",
    "mcp:typecheck": "npm run install:mcp-server && npx tsc -p tools/mcp/tsconfig.json --noEmit",
    "sync:file-core": "tsx tools/scripts/sync-file-content-core.ts",
    "sync:mcp-generated": "tsx tools/scripts/sync-mcp-generated.ts",
    "sync:mcp-generated:check": "tsx tools/scripts/sync-mcp-generated.ts --check",
    "check:twin-parity": "tsx tools/scripts/check-twin-parity.ts",
    "xss:scan": "xss-scan",
    "quality:check-code": "npm run format:check && npm run lint && npm run typecheck && npm run mcp:typecheck && npm run xss:scan",
    "quality:check-rules": "npm run validate:architecture && npm run validate:ephemeral && npm run validate && npm run validate:coverage && npm run sync:mcp-generated:check && npm run check:twin-parity && npm run mcp:check && npx tsx tools/validators/validate-requirement.ts requirements/auth/login-none.md && npm run validate:test-plan && npm run test:contract && npm run test:traceability && npm run test:mcp-profiles && npm run test:property && npm run test:unit && npm run test:file-content && npm run test:network-assert",
    "test:quality": "npm run install:mcp-server && npm run setup:check && npm run quality:check-code && npm run quality:check-rules && npm run mcp:build && npm run health:check",
    "setup": "tsx src/setup/index.ts",
    "setup:check": "tsx src/setup/index.ts --check",
    "setup:local": "tsx src/setup/index.ts --env local",
    "setup:staging": "tsx src/setup/index.ts --env staging",
    "setup:dev": "tsx src/setup/index.ts --env dev",
    "setup:production": "tsx src/setup/index.ts --env production",
    "env:edit": "tsx tools/scripts/env-edit.ts",
    "env:edit:list": "tsx tools/scripts/env-edit.ts --list",
    "env:status": "tsx tools/scripts/env-status.ts",
    "env:use": "tsx tools/scripts/env-use.ts",
    "env:use:local": "tsx tools/scripts/env-use.ts local",
    "env:use:dev": "tsx tools/scripts/env-use.ts dev",
    "env:use:staging": "tsx tools/scripts/env-use.ts staging",
    "env:use:production": "tsx tools/scripts/env-use.ts production --i-know",
    "auth:setup": "npx playwright test tests/auth.setup.ts --project=setup",
    "auth:setup:headed": "npx playwright test tests/auth.setup.ts --project=setup --workers=1 --headed",
    "auth:verify": "tsx tools/scripts/auth-verify.ts",
    "qa:run": "tsx tools/scripts/qa-run.ts",
    "manual:check": "tsx tools/scripts/manual-check.ts",
    "codegen": "tsx tools/scripts/codegen.ts",
    "health:check": "tsx tools/scripts/health-check-cli.ts",
    "health:check:strict": "tsx tools/scripts/health-check-cli.ts --strict",
    "archive:save": "tsx src/cli/archive-cli.ts save",
    "archive:view": "tsx src/cli/archive-cli.ts view",
    "archive:delete": "tsx src/cli/archive-cli.ts delete",
    "archive:clean": "tsx src/cli/archive-cli.ts clean",
    "archive:compare": "tsx src/cli/archive-cli.ts compare",
    "dashboard": "tsx src/cli/dashboard-server.ts --no-idle",
    "prepare": "husky",
    "note:set": "tsx src/cli/notes-cli.ts set",
    "note:list": "tsx src/cli/notes-cli.ts list",
    "qa:workflow": "tsx tools/scripts/workflow-run.ts",
    "test:auth-template": "tsx tools/scripts/__tests__/wizard-auth-template.test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@dotenvx/dotenvx": "^2.23.0",
    "@kitajs/html": "^4.2.13",
    "@kitajs/ts-html-plugin": "^4.1.4",
    "@playwright/mcp": "^0.0.80",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "@types/prompts": "^2.4.9",
    "eslint": "^10.10.0",
    "eslint-plugin-playwright": "^2.11.0",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "pdf-parse": "^2.4.5",
    "playwright": "1.63.0",
    "playwright-core": "1.63.0",
    "prompts": "^2.4.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css,html}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "tests/**/*.spec.ts": ["eslint --config eslint.playwright.config.mjs --fix"],
    "*.md": ["tsx tools/scripts/format-markdown.ts"]
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
