# Dependencies
node_modules/

# Per-environment configuration & secrets (never commit real credentials)
# Create config/environments/{local|dev|staging|production}.env with your credentials.
# Template examples (*.env.example) are tracked for reference.
config/environments/*.env
!config/environments/*.env.example
environments/*.env
!environments/*.env.example

# Local active profile pin (written by npm run env:use)
config/environments/.active-env
environments/.active-env

# dotenvx encryption keys
**/.env.keys
.env.keys

# Env edit & encryption backups (may contain secrets)
*.env.bak
config/environments/*.bak
environments/*.bak
**/*.env.bak
**/*.bak

# AI agent local cache & state (not part of release)
.hermes/
.agents/
.claude/
.gemini/

# Consolidated Runtime Artifacts (Hybrid Architecture)
artifacts/*
!artifacts/.gitkeep
!artifacts/reports/
artifacts/reports/*
!artifacts/reports/.gitkeep
!artifacts/test-results/
artifacts/test-results/*
!artifacts/test-results/.gitkeep
!artifacts/selector-catalog/
artifacts/selector-catalog/*
!artifacts/selector-catalog/.gitkeep
!artifacts/blob-report/
artifacts/blob-report/*
!artifacts/blob-report/.gitkeep

# Legacy output directories (fallback)
test-results/
playwright-report/
blob-report/
reports/
!reports/.gitkeep
selector-catalog/
!selector-catalog/.gitkeep
!selector-catalog/.meta.json

# Logger output
logs/

# Auth state cache (login cookies/localStorage per environment)
.auth/

# Property test transient artifacts
tests/__property_*/
src/__tests__/__property_*/
src/tests/__property_*/

# TypeScript build outputs
*.tsbuildinfo
tools/mcp/dist/
mcp-server/dist/

# Generated platform MCP configs (regenerable via `npm run mcp:config`)
claude_desktop_config.json
.cursor/mcp.json
.kiro/

# Generated capability manifest (generated at build/runtime)
agent-manifest.json

# OS & Editor files
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
.vscode/settings.json

# Local debug / temp artifacts
debug-validator.ts
*.diff

# Debug dumps / screenshots / MCP console logs (never commit)
_rpc*.json
_rpc*.jsonl
snack-*.png
*.mockup-detail.html
.playwright-mcp/
tools/scripts/_*.html
tools/scripts/_*.mjs
scripts/_*.html
scripts/_*.mjs

# Playwright visual-test snapshots (platform-specific PNG artifacts)
**/*.spec.ts-snapshots/

# Compiled env loader for plain node execution in MCP server
src/utils/*.js
src/utils/*.d.ts

# Setup wizard state & run pointer (per-machine, not tracked)
.wizard-state.json
.latest-run
